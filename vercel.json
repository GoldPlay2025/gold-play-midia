{
  "crons": [
    {
      "path": "/api/cron/cobranca",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/check-offline",
      "schedule": "*/3 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
